# --- What Prisma actually connects with ---
# This is NOT your anon key or service role key — it's the direct Postgres
# connection string. Find it in Supabase: Project Settings -> Database ->
# Connection string -> URI. Use the "Session" / direct connection (port
# 5432), not the pooled one (port 6543, pgbouncer) — this is a normal
# long-running server, not a serverless function, so it doesn't need
# connection pooling, and Prisma's migration commands need a direct
# connection to work correctly anyway.
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

PORT=3000

# --- Supabase API-layer credentials ---
# Not used by any code in this backend yet (everything here talks to
# Postgres directly via DATABASE_URL, never through Supabase's REST/GraphQL
# API or the Supabase client SDK) — kept here so they're available if that
# changes later, e.g. wiring up Supabase Storage or Realtime.
#
# Fill these in directly in your own .env file, in your own editor, rather
# than pasting them anywhere else — SUPABASE_SERVICE_ROLE_KEY in particular
# bypasses every RLS policy from prisma/rls.sql entirely, so it's worth
# treating with the same care as a database superuser password.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If unset, card funding uses the in-memory stub adapter instead
# of calling Stripe for real — see src/adapters/funding/factory.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
